#!/usr/bin/env -S dotnet run --file 
#:package Microsoft.Extensions.DependencyInjection@10.0.12
#:package Spectre.Console@0.57.2
#:package Lestaly.General@0.145.0
using Lestaly;
using Microsoft.Extensions.DependencyInjection;
using Spectre.Console;

return await Paved.ProceedAsync(async () =>
{
    var services = new ServiceCollection();
    services.AddSingleton<IAnsiConsole>(AnsiConsole.Console);
    services.AddTransient<ISample, InjectSample>();

    var provider = services.BuildServiceProvider();

    var sample = provider.GetRequiredService<ISample>();
    sample.Run();
});

interface ISample
{
    public void Run();
}

class InjectSample(IAnsiConsole console) : ISample
{
    public void Run()
    {
        // Instead of: AnsiConsole.MarkupLine("[green]Hello![/]");
        // Use the injected console:
        console.MarkupLine("[green]Hello![/]");
    }
}
